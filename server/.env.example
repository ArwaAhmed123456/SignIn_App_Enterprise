# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/Tripod?retryWrites=true&w=majority

# JWT secret (use a long random string in production)
JWT_SECRET=your_very_long_random_secret_here

# Email settings (Gmail shown, use any SMTP provider)
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Sign In App <your@gmail.com>

# SQLite database (local, no setup needed)
DATABASE_URL="file:./dev.db"
