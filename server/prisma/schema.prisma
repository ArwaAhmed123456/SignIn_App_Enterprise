// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  firstName    String?
  lastName     String?
  phone        String?
  organization String?
  role         String    @default("admin") // admin, superadmin
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Account {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites         Site[]
  visitorGroups VisitorGroup[]
}

model Site {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  password         String?
  adminEmail       String?
  address          String?
  accountId        String?
  account          Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activityLogs    ActivityLog[]
  members         Member[]
  visitorGroups   VisitorGroup[]
  preRegistrations PreRegistration[]
  evacuationReports EvacuationReport[]
}

model VisitorGroup {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("Standard") // Standard, Repeat, Delivery
  description String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          Member[]
  preRegistrations PreRegistration[]
}

model Member {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String?
  email          String?       @unique
  phone          String?
  status         String        @default("Current") // Current, Upcoming, Archived
  startDate      DateTime?
  endDate        DateTime?
  visitorGroupId String?
  visitorGroup   VisitorGroup? @relation(fields: [visitorGroupId], references: [id], onDelete: SetNull)

  // Legacy Guard fields
  password          String?
  role              String?  @default("guard")
  permissions       String?  // Stored as JSON string
  siteId            String?
  site              Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  mobilePaired      Boolean  @default(false)
  mobileDeviceId    String?
  mobilePairedAt    DateTime?
  mobileTokenHash   String?
  mobileTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs     ActivityLog[]
  preRegistrations PreRegistration[]
}

model PreRegistration {
  id             String        @id @default(uuid())
  name           String
  email          String?
  phone          String?
  notes          String?
  expectedDate   DateTime?
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitorGroupId String?
  visitorGroup   VisitorGroup? @relation(fields: [visitorGroupId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status         String        @default("Pending") // Pending, Arrived, Cancelled
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ActivityLog {
  id       String  @id @default(uuid())
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Legacy fields
  name     String?
  trade    String?
  carReg   String?
  userType String?
  timeIn   String?
  timeOut  String?
  hours    Float?
  date     String?
  reason   String?
  imageUrl String?

  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  duration  Int?      // Duration in minutes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model EvacuationReport {
  id                String   @id @default(uuid())
  siteId            String
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status            String   @default("Active") // Active, Completed
  startedAt         DateTime @default(now())
  startedBy         String
  endedAt           DateTime?
  endedBy           String?
  durationSeconds   Int?
  accountedFor      String?
  leaveReport       String?
  notificationsJson String?
  participantsJson  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
