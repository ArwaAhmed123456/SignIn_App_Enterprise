{
  "expo": {
    "name": "Tripod Services",
    "slug": "tripodhubauth",
    "scheme": "tripodservices",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Professional visitor management companion app for Tripod Services",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haalim.tripodservices",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to take your visitor photo for identity verification on site.",
        "NSMicrophoneUsageDescription": "Microphone access for voice features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.haalim.tripodservices",
      "versionCode": 10,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tripod-signin-app.onrender.com/api",
      "webAppUrl": "https://tripod-signin-app.onrender.com",
      "eas": {
        "projectId": "93a2574b-7e98-4ab5-a640-e8c08da3f5df"
      }
    },
    "owner": "ayeshaes-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93a2574b-7e98-4ab5-a640-e8c08da3f5df"
    }
  }
}
