{
  "expo": {
    "name": "Tripod Services",
    "slug": "tripodhubauth",
    "scheme": "tripodservices",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Professional visitor management companion app for Tripod Services",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haalim.tripodservices",
      "buildNumber": "1.0.6",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to take your visitor photo for identity verification on site.",
        "NSMicrophoneUsageDescription": "Microphone access for voice features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.haalim.tripodservices",
      "versionCode": 12,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tripod-signin-app.onrender.com/api",
      "webAppUrl": "https://tripod-signin-app.onrender.com",
      "eas": {
        "projectId": "d198d300-5db6-4012-aad7-d97993f314f4"
      }
    },
    "owner": "haalim",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
